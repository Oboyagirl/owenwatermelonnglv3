rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName']) &&
        data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'avatarId', 'favoriteGameIds', 'recentGameIds', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!('avatarId' in data) || (data.avatarId is string && data.avatarId.size() <= 64)) &&
        (!('favoriteGameIds' in data) || (data.favoriteGameIds is list && data.favoriteGameIds.size() <= 100)) &&
        (!('recentGameIds' in data) || (data.recentGameIds is list && data.recentGameIds.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidGameSave(data) {
      return data.keys().hasAll(['id', 'userId', 'gameId', 'slot', 'saveData']) &&
        data.keys().hasOnly(['id', 'userId', 'gameId', 'slot', 'title', 'saveData', 'saveType', 'score', 'level', 'deviceLabel', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.gameId is string && data.gameId.size() > 0 && data.gameId.size() <= 128 &&
        data.slot is string && data.slot.size() > 0 && data.slot.size() <= 32 &&
        data.saveData is string && data.saveData.size() <= 500000 &&
        (!('title' in data) || (data.title is string && data.title.size() <= 128)) &&
        (!('saveType' in data) || (data.saveType is string && data.saveType.size() <= 32)) &&
        (!('score' in data) || (data.score is number)) &&
        (!('level' in data) || (data.level is string && data.level.size() <= 64)) &&
        (!('deviceLabel' in data) || (data.deviceLabel is string && data.deviceLabel.size() <= 128)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidGameStats(data) {
      return data.keys().hasAll(['id', 'userId', 'gameId']) &&
        data.keys().hasOnly(['id', 'userId', 'gameId', 'playCount', 'playTimeSeconds', 'lastPlayedAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.gameId is string && data.gameId.size() > 0 && data.gameId.size() <= 128 &&
        (!('playCount' in data) || (data.playCount is number)) &&
        (!('playTimeSeconds' in data) || (data.playTimeSeconds is number)) &&
        (!('lastPlayedAt' in data) || (data.lastPlayedAt is string && data.lastPlayedAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      // Cloud Game Saves Subcollection
      match /saves/{saveId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(saveId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(saveId) && isValidGameSave(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(saveId) && isValidGameSave(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(saveId);
      }

      // Game Statistics Subcollection
      match /stats/{gameId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(gameId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(gameId) && isValidGameStats(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(gameId) && isValidGameStats(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(gameId);
      }
    }
  }
}
