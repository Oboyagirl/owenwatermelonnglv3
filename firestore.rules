rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName']) &&
        data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'avatarId', 'favoriteGameIds', 'recentGameIds', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        (!('avatarId' in data) || data.avatarId == null || (data.avatarId is string && data.avatarId.size() <= 64)) &&
        (!('favoriteGameIds' in data) || data.favoriteGameIds == null || (data.favoriteGameIds is list && data.favoriteGameIds.size() <= 100)) &&
        (!('recentGameIds' in data) || data.recentGameIds == null || (data.recentGameIds is list && data.recentGameIds.size() <= 50)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidGameSave(data) {
      return data.keys().hasAll(['id', 'userId', 'gameId', 'slot', 'saveData']) &&
        data.keys().hasOnly(['id', 'userId', 'gameId', 'slot', 'title', 'saveData', 'saveType', 'score', 'level', 'deviceLabel', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.gameId is string && data.gameId.size() > 0 && data.gameId.size() <= 128 &&
        data.slot is string && data.slot.size() > 0 && data.slot.size() <= 32 &&
        data.saveData is string && data.saveData.size() <= 500000 &&
        (!('title' in data) || data.title == null || (data.title is string && data.title.size() <= 128)) &&
        (!('saveType' in data) || data.saveType == null || (data.saveType is string && data.saveType.size() <= 32)) &&
        (!('score' in data) || data.score == null || (data.score is number)) &&
        (!('level' in data) || data.level == null || (data.level is string && data.level.size() <= 64)) &&
        (!('deviceLabel' in data) || data.deviceLabel == null || (data.deviceLabel is string && data.deviceLabel.size() <= 128)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidGameStats(data) {
      return data.keys().hasAll(['id', 'userId', 'gameId']) &&
        data.keys().hasOnly(['id', 'userId', 'gameId', 'playCount', 'playTimeSeconds', 'lastPlayedAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.gameId is string && data.gameId.size() > 0 && data.gameId.size() <= 128 &&
        (!('playCount' in data) || data.playCount == null || (data.playCount is number)) &&
        (!('playTimeSeconds' in data) || data.playTimeSeconds == null || (data.playTimeSeconds is number)) &&
        (!('lastPlayedAt' in data) || data.lastPlayedAt == null || (data.lastPlayedAt is string && data.lastPlayedAt.size() <= 64)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidRoomCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 8 && code.matches('^[A-Z0-9]+$');
    }

    function isValidTeamSeat(seat) {
      return seat is map &&
        seat.keys().hasAll(['kind', 'uid', 'playerId', 'name', 'botId']) &&
        seat.keys().hasOnly(['kind', 'uid', 'playerId', 'name', 'botId']) &&
        seat.kind is string && seat.kind.size() >= 3 && seat.kind.size() <= 5 && seat.kind in ['open', 'human', 'bot'] &&
        (seat.uid == null || (seat.uid is string && seat.uid.size() > 0 && seat.uid.size() <= 128)) &&
        (seat.playerId == null || (seat.playerId is string && seat.playerId.size() > 0 && seat.playerId.size() <= 64)) &&
        (seat.name == null || (seat.name is string && seat.name.size() > 0 && seat.name.size() <= 24)) &&
        (seat.botId == null || (seat.botId is string && seat.botId.size() > 0 && seat.botId.size() <= 32));
    }

    function isValidSeatList(seats) {
      return seats is list &&
        seats.size() >= 1 &&
        seats.size() <= 2 &&
        isValidTeamSeat(seats[0]) &&
        (seats.size() < 2 || isValidTeamSeat(seats[1]));
    }

    function isValidUidList4(uids) {
      return uids is list &&
        uids.size() <= 4 &&
        (uids.size() == 0 || (uids[0] is string && uids[0].size() > 0 && uids[0].size() <= 128)) &&
        (uids.size() < 2 || (uids[1] is string && uids[1].size() > 0 && uids[1].size() <= 128)) &&
        (uids.size() < 3 || (uids[2] is string && uids[2].size() > 0 && uids[2].size() <= 128)) &&
        (uids.size() < 4 || (uids[3] is string && uids[3].size() > 0 && uids[3].size() <= 128));
    }

    function isValidRematchVotes4(votes) {
      return votes is list &&
        votes.size() <= 4 &&
        (votes.size() == 0 || (votes[0] is string && votes[0].size() >= 1 && votes[0].size() <= 6)) &&
        (votes.size() < 2 || (votes[1] is string && votes[1].size() >= 1 && votes[1].size() <= 6)) &&
        (votes.size() < 3 || (votes[2] is string && votes[2].size() >= 1 && votes[2].size() <= 6)) &&
        (votes.size() < 4 || (votes[3] is string && votes[3].size() >= 1 && votes[3].size() <= 6));
    }

    function isValidChessRoom(data) {
      return data.keys().hasAll([
        'code', 'creatorAuthUid', 'status', 'timeControlId', 'baseMs', 'incMs',
        'whiteAuthUid', 'whitePlayerId', 'whiteName', 'whiteElo',
        'blackAuthUid', 'blackPlayerId', 'blackName', 'blackElo',
        'moves', 'turn', 'whiteTimeMs', 'blackTimeMs', 'clockAnchorMs',
        'resignedWinner', 'timeoutWinner', 'rematchVotes', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'code', 'creatorAuthUid', 'status', 'timeControlId', 'baseMs', 'incMs',
        'teamMode', 'whiteSeats', 'blackSeats', 'participantUids', 'activeSeatKind', 'activeSeatUid',
        'whiteAuthUid', 'whitePlayerId', 'whiteName', 'whiteElo',
        'blackAuthUid', 'blackPlayerId', 'blackName', 'blackElo',
        'moves', 'turn', 'whiteTimeMs', 'blackTimeMs', 'clockAnchorMs',
        'resignedWinner', 'timeoutWinner', 'rematchVotes', 'createdAt', 'updatedAt'
      ]) &&
      isValidRoomCode(data.code) &&
      data.creatorAuthUid is string && data.creatorAuthUid.size() > 0 && data.creatorAuthUid.size() <= 128 &&
      data.status is string && data.status.size() > 0 && data.status.size() <= 16 && data.status in ['waiting', 'active', 'finished'] &&
      (!('teamMode' in data) || (data.teamMode is string && data.teamMode.size() == 3 && data.teamMode in ['1v1', '2v2'])) &&
      (!('whiteSeats' in data) || isValidSeatList(data.whiteSeats)) &&
      (!('blackSeats' in data) || isValidSeatList(data.blackSeats)) &&
      (!('participantUids' in data) || isValidUidList4(data.participantUids)) &&
      (!('activeSeatKind' in data) || (data.activeSeatKind is string && data.activeSeatKind.size() >= 3 && data.activeSeatKind.size() <= 5 && data.activeSeatKind in ['open', 'human', 'bot'])) &&
      (!('activeSeatUid' in data) || data.activeSeatUid == null || (data.activeSeatUid is string && data.activeSeatUid.size() > 0 && data.activeSeatUid.size() <= 128)) &&
      data.timeControlId is string && data.timeControlId.size() > 0 && data.timeControlId.size() <= 16 &&
      data.baseMs is int && data.baseMs >= 0 && data.baseMs <= 3600000 &&
      data.incMs is int && data.incMs >= 0 && data.incMs <= 120000 &&
      (data.whiteAuthUid == null || (data.whiteAuthUid is string && data.whiteAuthUid.size() > 0 && data.whiteAuthUid.size() <= 128)) &&
      (data.whitePlayerId == null || (data.whitePlayerId is string && data.whitePlayerId.size() > 0 && data.whitePlayerId.size() <= 64)) &&
      (data.whiteName == null || (data.whiteName is string && data.whiteName.size() > 0 && data.whiteName.size() <= 24)) &&
      data.whiteElo is int && data.whiteElo >= 100 && data.whiteElo <= 4000 &&
      (data.blackAuthUid == null || (data.blackAuthUid is string && data.blackAuthUid.size() > 0 && data.blackAuthUid.size() <= 128)) &&
      (data.blackPlayerId == null || (data.blackPlayerId is string && data.blackPlayerId.size() > 0 && data.blackPlayerId.size() <= 64)) &&
      (data.blackName == null || (data.blackName is string && data.blackName.size() > 0 && data.blackName.size() <= 24)) &&
      data.blackElo is int && data.blackElo >= 100 && data.blackElo <= 4000 &&
      data.moves is list && data.moves.size() <= 500 &&
      (data.moves.size() == 0 || (data.moves[0] is string && data.moves[0].size() >= 7 && data.moves[0].size() <= 16)) &&
      data.turn is string && data.turn.size() == 1 && data.turn in ['w', 'b'] &&
      data.whiteTimeMs is int && data.whiteTimeMs >= 0 && data.whiteTimeMs <= 3600000 &&
      data.blackTimeMs is int && data.blackTimeMs >= 0 && data.blackTimeMs <= 3600000 &&
      (data.clockAnchorMs == null || (data.clockAnchorMs is int && data.clockAnchorMs > 0)) &&
      (data.resignedWinner == null || (data.resignedWinner is string && data.resignedWinner.size() == 1 && data.resignedWinner in ['w', 'b'])) &&
      (data.timeoutWinner == null || (data.timeoutWinner is string && data.timeoutWinner.size() >= 1 && data.timeoutWinner.size() <= 4 && data.timeoutWinner in ['w', 'b', 'draw'])) &&
      isValidRematchVotes4(data.rematchVotes) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isChessRoomParticipant(data) {
      return isSignedIn() && (
        data.whiteAuthUid == request.auth.uid ||
        data.blackAuthUid == request.auth.uid ||
        ('participantUids' in data && request.auth.uid in data.participantUids)
      );
    }

    function isValidArcadeGameType(gt) {
      return gt is string && gt.size() > 0 && gt.size() <= 32 &&
        gt in ['connect4', 'checkers', 'reversi', 'dots-and-boxes', 'gomoku', 'ultimate-ttt', 'mancala', 'tictactoe', 'draw-guess', 'battleship', 'memory-match', 'dice-duel', 'pixel-guess', 'emoji-charades', 'nim', 'misere-nim', 'chomp', 'hex', 'grid-link-4', 'order-chaos', 'misere-ttt', 'gravity-5', 'snort', 'col-clash', 'domineering', 'cram', 'obstruction', 'ataxx', 'breakthrough', 'kings-escape', 'wordle-duel', 'hangman-duel', 'mastermind', 'hilo-target', 'word-chain', 'blackjack-21', 'yacht-dice', 'tug-of-war', 'rps-arena', 'penalty-kick', 'mines-duel', 'sos-grid', 'symmetry-art', 'color-match', 'emoji-story', 'quoridor', 'pente', 'nine-mens-morris', 'santorini-lite', 'fox-and-hounds', 'isola', 'tak-duel', 'go-mini', 'amazons-mini', 'tron-turn', 'shogi-pocket', 'gobblet-mini', 'splatter-turf', 'knight-duel', 'anagram-scramble', 'trivia-showdown', 'math-blitz', 'simon-duel', 'boggle-duel', 'sudoku-duel', 'uno-duel', 'go-fish', 'poker-dice', 'liars-dice', 'farkle-duel', 'coin-row', 'high-noon-duel'];
    }

    function isValidArcadeRoom(data) {
      return data.keys().hasAll([
        'code', 'gameType', 'creatorAuthUid', 'status',
        'p1AuthUid', 'p1PlayerId', 'p1Name',
        'p2AuthUid', 'p2PlayerId', 'p2Name',
        'moves', 'turn', 'winner', 'resignedWinner', 'rematchVotes',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'code', 'gameType', 'creatorAuthUid', 'status',
        'teamMode', 'team1Seats', 'team2Seats', 'participantUids',
        'team1TurnCount', 'team2TurnCount', 'activeSeatKind', 'activeSeatUid',
        'p1AuthUid', 'p1PlayerId', 'p1Name',
        'p2AuthUid', 'p2PlayerId', 'p2Name',
        'moves', 'turn', 'winner', 'resignedWinner', 'rematchVotes',
        'createdAt', 'updatedAt'
      ]) &&
      isValidRoomCode(data.code) &&
      isValidArcadeGameType(data.gameType) &&
      data.creatorAuthUid is string && data.creatorAuthUid.size() > 0 && data.creatorAuthUid.size() <= 128 &&
      data.status is string && data.status.size() > 0 && data.status.size() <= 16 && data.status in ['waiting', 'active', 'finished'] &&
      (!('teamMode' in data) || (data.teamMode is string && data.teamMode.size() == 3 && data.teamMode in ['1v1', '2v2'])) &&
      (!('team1Seats' in data) || isValidSeatList(data.team1Seats)) &&
      (!('team2Seats' in data) || isValidSeatList(data.team2Seats)) &&
      (!('participantUids' in data) || isValidUidList4(data.participantUids)) &&
      (!('team1TurnCount' in data) || (data.team1TurnCount is int && data.team1TurnCount >= 0 && data.team1TurnCount <= 10000)) &&
      (!('team2TurnCount' in data) || (data.team2TurnCount is int && data.team2TurnCount >= 0 && data.team2TurnCount <= 10000)) &&
      (!('activeSeatKind' in data) || (data.activeSeatKind is string && data.activeSeatKind.size() >= 3 && data.activeSeatKind.size() <= 5 && data.activeSeatKind in ['open', 'human', 'bot'])) &&
      (!('activeSeatUid' in data) || data.activeSeatUid == null || (data.activeSeatUid is string && data.activeSeatUid.size() > 0 && data.activeSeatUid.size() <= 128)) &&
      (data.p1AuthUid == null || (data.p1AuthUid is string && data.p1AuthUid.size() > 0 && data.p1AuthUid.size() <= 128)) &&
      (data.p1PlayerId == null || (data.p1PlayerId is string && data.p1PlayerId.size() > 0 && data.p1PlayerId.size() <= 64)) &&
      (data.p1Name == null || (data.p1Name is string && data.p1Name.size() > 0 && data.p1Name.size() <= 24)) &&
      (data.p2AuthUid == null || (data.p2AuthUid is string && data.p2AuthUid.size() > 0 && data.p2AuthUid.size() <= 128)) &&
      (data.p2PlayerId == null || (data.p2PlayerId is string && data.p2PlayerId.size() > 0 && data.p2PlayerId.size() <= 64)) &&
      (data.p2Name == null || (data.p2Name is string && data.p2Name.size() > 0 && data.p2Name.size() <= 24)) &&
      data.moves is list && data.moves.size() <= 600 &&
      (data.moves.size() == 0 || (data.moves[0] is string && data.moves[0].size() >= 1 && data.moves[0].size() <= 800)) &&
      data.turn is string && data.turn.size() == 2 && data.turn in ['p1', 'p2'] &&
      (data.winner == null || (data.winner is string && data.winner.size() >= 2 && data.winner.size() <= 4 && data.winner in ['p1', 'p2', 'draw'])) &&
      (data.resignedWinner == null || (data.resignedWinner is string && data.resignedWinner.size() == 2 && data.resignedWinner in ['p1', 'p2'])) &&
      isValidRematchVotes4(data.rematchVotes) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isArcadeRoomParticipant(data) {
      return isSignedIn() && (
        data.p1AuthUid == request.auth.uid ||
        data.p2AuthUid == request.auth.uid ||
        ('participantUids' in data && request.auth.uid in data.participantUids)
      );
    }

    function isValidPartyMember(m) {
      return m is map &&
        m.keys().hasAll(['uid', 'playerId', 'displayName', 'avatarId', 'team']) &&
        m.keys().hasOnly(['uid', 'playerId', 'displayName', 'avatarId', 'team']) &&
        isValidId(m.uid) &&
        m.playerId is string && m.playerId.size() > 0 && m.playerId.size() <= 64 &&
        m.displayName is string && m.displayName.size() > 0 && m.displayName.size() <= 24 &&
        m.avatarId is string && m.avatarId.size() > 0 && m.avatarId.size() <= 64 &&
        m.team is string && m.team.size() == 1 && m.team in ['A', 'B'];
    }

    function isValidParty(data) {
      return data.keys().hasAll([
        'id', 'code', 'leaderUid', 'status', 'matchMode', 'opponentMode',
        'gameKind', 'gameType', 'gameTitle', 'botId', 'members', 'memberUids',
        'activeRoomCode', 'activeGameKind', 'activeGameType', 'activeLaunchId',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'code', 'leaderUid', 'status', 'matchMode', 'opponentMode',
        'gameKind', 'gameType', 'gameTitle', 'botId', 'members', 'memberUids',
        'activeRoomCode', 'activeGameKind', 'activeGameType', 'activeLaunchId',
        'createdAt', 'updatedAt'
      ]) &&
      isValidRoomCode(data.id) &&
      data.id == data.code &&
      isValidId(data.leaderUid) &&
      data.status is string && data.status.size() > 0 && data.status.size() <= 16 && data.status in ['lobby', 'in_game'] &&
      data.matchMode is string && data.matchMode.size() == 3 && data.matchMode in ['1v1', '2v2'] &&
      data.opponentMode is string && data.opponentMode.size() >= 4 && data.opponentMode.size() <= 8 && data.opponentMode in ['humans', 'bots'] &&
      data.gameKind is string && data.gameKind.size() >= 5 && data.gameKind.size() <= 8 && data.gameKind in ['chess', 'arcade'] &&
      data.gameType is string && data.gameType.size() > 0 && data.gameType.size() <= 32 &&
      (data.gameType == 'chess' || isValidArcadeGameType(data.gameType)) &&
      data.gameTitle is string && data.gameTitle.size() > 0 && data.gameTitle.size() <= 64 &&
      data.botId is string && data.botId.size() > 0 && data.botId.size() <= 32 &&
      data.members is list && data.members.size() >= 1 && data.members.size() <= 4 &&
      isValidPartyMember(data.members[0]) &&
      (data.members.size() < 2 || isValidPartyMember(data.members[1])) &&
      (data.members.size() < 3 || isValidPartyMember(data.members[2])) &&
      (data.members.size() < 4 || isValidPartyMember(data.members[3])) &&
      isValidUidList4(data.memberUids) &&
      data.memberUids.size() == data.members.size() &&
      data.leaderUid in data.memberUids &&
      (data.activeRoomCode == null || isValidRoomCode(data.activeRoomCode)) &&
      (data.activeGameKind == null || (data.activeGameKind is string && data.activeGameKind.size() >= 5 && data.activeGameKind.size() <= 8 && data.activeGameKind in ['chess', 'arcade'])) &&
      (data.activeGameType == null || (data.activeGameType is string && data.activeGameType.size() > 0 && data.activeGameType.size() <= 32)) &&
      (data.activeLaunchId == null || (data.activeLaunchId is string && data.activeLaunchId.size() > 0 && data.activeLaunchId.size() <= 64)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPartyInvite(data) {
      return data.keys().hasAll([
        'id', 'partyId', 'partyCode', 'fromUid', 'fromName', 'fromAvatarId',
        'toUid', 'toName', 'participantUids', 'matchMode', 'opponentMode',
        'gameKind', 'gameType', 'gameTitle', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'partyId', 'partyCode', 'fromUid', 'fromName', 'fromAvatarId',
        'toUid', 'toName', 'participantUids', 'matchMode', 'opponentMode',
        'gameKind', 'gameType', 'gameTitle', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidRoomCode(data.partyId) &&
      data.partyId == data.partyCode &&
      isValidId(data.fromUid) &&
      data.fromName is string && data.fromName.size() > 0 && data.fromName.size() <= 64 &&
      data.fromAvatarId is string && data.fromAvatarId.size() > 0 && data.fromAvatarId.size() <= 64 &&
      isValidId(data.toUid) &&
      data.fromUid != data.toUid &&
      data.toName is string && data.toName.size() > 0 && data.toName.size() <= 64 &&
      data.participantUids is list && data.participantUids.size() == 2 &&
      data.participantUids[0] is string && data.participantUids[0] == data.fromUid &&
      data.participantUids[1] is string && data.participantUids[1] == data.toUid &&
      data.matchMode is string && data.matchMode.size() == 3 && data.matchMode in ['1v1', '2v2'] &&
      data.opponentMode is string && data.opponentMode.size() >= 4 && data.opponentMode.size() <= 8 && data.opponentMode in ['humans', 'bots'] &&
      data.gameKind is string && data.gameKind.size() >= 5 && data.gameKind.size() <= 8 && data.gameKind in ['chess', 'arcade'] &&
      data.gameType is string && data.gameType.size() > 0 && data.gameType.size() <= 32 &&
      (data.gameType == 'chess' || isValidArcadeGameType(data.gameType)) &&
      data.gameTitle is string && data.gameTitle.size() > 0 && data.gameTitle.size() <= 64 &&
      data.status is string && data.status.size() > 0 && data.status.size() <= 16 && data.status in ['pending', 'accepted', 'declined', 'cancelled'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidFriendCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 16 && code.matches('^[A-Z0-9\\-]+$');
    }

    function isValidChatProfile(data) {
      return data.keys().hasAll([
          'userId', 'displayName', 'friendCode', 'avatarId', 'discoverable', 'isOnline', 'lastSeenAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'displayName', 'friendCode', 'avatarId', 'discoverable', 'isOnline', 'lastSeenAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == request.auth.uid && isValidId(data.userId) &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
        isValidFriendCode(data.friendCode) &&
        data.avatarId is string && data.avatarId.size() > 0 && data.avatarId.size() <= 64 &&
        data.discoverable is bool &&
        data.isOnline is bool &&
        data.lastSeenAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserContact(data) {
      return data.keys().hasAll(['contactUid', 'displayName', 'friendCode', 'avatarId', 'addedAt']) &&
        data.keys().hasOnly(['contactUid', 'displayName', 'friendCode', 'avatarId', 'nickname', 'addedAt']) &&
        data.contactUid is string && isValidId(data.contactUid) &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
        isValidFriendCode(data.friendCode) &&
        data.avatarId is string && data.avatarId.size() > 0 && data.avatarId.size() <= 64 &&
        (!('nickname' in data) || data.nickname == null || (data.nickname is string && data.nickname.size() <= 64)) &&
        data.addedAt is timestamp;
    }

    function isValidChatThread(data) {
      return data.keys().hasAll([
          'threadId', 'userAUid', 'userBUid', 'participantUids',
          'userAName', 'userBName', 'userAAvatarId', 'userBAvatarId',
          'lastMessageText', 'lastMessageSenderUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'threadId', 'userAUid', 'userBUid', 'participantUids',
          'userAName', 'userBName', 'userAAvatarId', 'userBAvatarId',
          'lastMessageText', 'lastMessageSenderUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.threadId) &&
        data.userAUid is string && isValidId(data.userAUid) &&
        data.userBUid is string && isValidId(data.userBUid) &&
        data.userAUid != data.userBUid &&
        data.threadId == (data.userAUid + '_' + data.userBUid) &&
        data.participantUids is list && data.participantUids.size() == 2 &&
        data.participantUids[0] is string && data.participantUids[0] == data.userAUid &&
        data.participantUids[1] is string && data.participantUids[1] == data.userBUid &&
        data.userAName is string && data.userAName.size() > 0 && data.userAName.size() <= 64 &&
        data.userBName is string && data.userBName.size() > 0 && data.userBName.size() <= 64 &&
        data.userAAvatarId is string && data.userAAvatarId.size() > 0 && data.userAAvatarId.size() <= 64 &&
        data.userBAvatarId is string && data.userBAvatarId.size() > 0 && data.userBAvatarId.size() <= 64 &&
        data.lastMessageText is string && data.lastMessageText.size() <= 300 &&
        (data.lastMessageSenderUid == null || (
          data.lastMessageSenderUid is string &&
          data.lastMessageSenderUid.size() > 0 &&
          data.lastMessageSenderUid.size() <= 128 &&
          data.lastMessageSenderUid in data.participantUids
        )) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'id', 'threadId', 'senderUid', 'senderName', 'senderAvatarId', 'participantUids', 'text', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'threadId', 'senderUid', 'senderName', 'senderAvatarId', 'participantUids', 'text', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.threadId) &&
        data.senderUid is string && data.senderUid == request.auth.uid && isValidId(data.senderUid) &&
        data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 64 &&
        data.senderAvatarId is string && data.senderAvatarId.size() > 0 && data.senderAvatarId.size() <= 64 &&
        data.participantUids is list && data.participantUids.size() == 2 &&
        data.participantUids[0] is string && isValidId(data.participantUids[0]) &&
        data.participantUids[1] is string && isValidId(data.participantUids[1]) &&
        data.participantUids[0] != data.participantUids[1] &&
        request.auth.uid in data.participantUids &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
        data.createdAt is timestamp;
    }

    function isValidGameInvite(data) {
      return data.keys().hasAll([
          'id', 'fromUid', 'fromName', 'fromAvatarId', 'toUid', 'toName',
          'participantUids', 'gameKind', 'gameType', 'gameTitle', 'roomCode',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'fromUid', 'fromName', 'fromAvatarId', 'toUid', 'toName',
          'participantUids', 'gameKind', 'gameType', 'gameTitle', 'roomCode',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.fromUid is string && isValidId(data.fromUid) &&
        data.fromName is string && data.fromName.size() > 0 && data.fromName.size() <= 64 &&
        data.fromAvatarId is string && data.fromAvatarId.size() > 0 && data.fromAvatarId.size() <= 64 &&
        data.toUid is string && isValidId(data.toUid) &&
        data.fromUid != data.toUid &&
        data.toName is string && data.toName.size() > 0 && data.toName.size() <= 64 &&
        data.participantUids is list && data.participantUids.size() == 2 &&
        data.participantUids[0] is string && data.participantUids[0] == data.fromUid &&
        data.participantUids[1] is string && data.participantUids[1] == data.toUid &&
        data.gameKind is string && data.gameKind.size() > 0 && data.gameKind.size() <= 16 &&
        data.gameKind in ['chess', 'arcade'] &&
        data.gameType is string && data.gameType.size() > 0 && data.gameType.size() <= 32 &&
        (data.gameType == 'chess' || isValidArcadeGameType(data.gameType)) &&
        data.gameTitle is string && data.gameTitle.size() > 0 && data.gameTitle.size() <= 64 &&
        isValidRoomCode(data.roomCode) &&
        data.status is string && data.status.size() > 0 && data.status.size() <= 16 &&
        data.status in ['pending', 'accepted', 'declined', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCallSession(data) {
      return data.keys().hasAll([
          'id', 'callerUid', 'callerName', 'callerAvatarId',
          'calleeUid', 'calleeName', 'calleeAvatarId', 'participantUids',
          'mode', 'status', 'contextLabel', 'sdpOffer', 'sdpAnswer',
          'createdAt', 'updatedAt', 'endedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'callerUid', 'callerName', 'callerAvatarId',
          'calleeUid', 'calleeName', 'calleeAvatarId', 'participantUids',
          'mode', 'status', 'contextLabel', 'sdpOffer', 'sdpAnswer',
          'createdAt', 'updatedAt', 'endedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.callerUid) &&
        data.callerName is string && data.callerName.size() > 0 && data.callerName.size() <= 64 &&
        data.callerAvatarId is string && data.callerAvatarId.size() > 0 && data.callerAvatarId.size() <= 64 &&
        isValidId(data.calleeUid) &&
        data.callerUid != data.calleeUid &&
        data.calleeName is string && data.calleeName.size() > 0 && data.calleeName.size() <= 64 &&
        data.calleeAvatarId is string && data.calleeAvatarId.size() > 0 && data.calleeAvatarId.size() <= 64 &&
        data.participantUids is list && data.participantUids.size() == 2 &&
        data.participantUids[0] is string && data.participantUids[0] == data.callerUid &&
        data.participantUids[1] is string && data.participantUids[1] == data.calleeUid &&
        data.mode is string && data.mode.size() > 0 && data.mode.size() <= 8 &&
        data.mode in ['audio', 'video'] &&
        data.status is string && data.status.size() > 0 && data.status.size() <= 16 &&
        data.status in ['ringing', 'active', 'ended', 'declined', 'missed'] &&
        (data.contextLabel == null || (data.contextLabel is string && data.contextLabel.size() <= 80)) &&
        data.sdpOffer is string && data.sdpOffer.size() > 0 && data.sdpOffer.size() <= 24000 &&
        (data.sdpAnswer == null || (data.sdpAnswer is string && data.sdpAnswer.size() > 0 && data.sdpAnswer.size() <= 24000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (data.endedAt == null || data.endedAt is timestamp);
    }

    function isValidCallCandidate(data) {
      return data.keys().hasAll(['id', 'fromUid', 'toUid', 'type', 'candidate', 'createdAt']) &&
        data.keys().hasOnly(['id', 'fromUid', 'toUid', 'type', 'candidate', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.fromUid) &&
        isValidId(data.toUid) &&
        data.fromUid != data.toUid &&
        data.type is string && data.type.size() > 0 && data.type.size() <= 16 &&
        data.type in ['offer-ice', 'answer-ice', 'ice'] &&
        data.candidate is string && data.candidate.size() > 0 && data.candidate.size() <= 4096 &&
        data.createdAt is timestamp;
    }

    function isValidLeaderboardProfile(data) {
      return data.keys().hasAll([
          'userId', 'displayName', 'avatarId', 'isListed',
          'overallElo', 'chessElo', 'arcadeElo', 'bestElo',
          'totalMatches', 'wins', 'losses', 'draws',
          'chessMatches', 'chessWins', 'arcadeMatches', 'arcadeWins',
          'winStreak', 'bestWinStreak', 'lastMatchId', 'lastGameTitle',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'displayName', 'avatarId', 'isListed',
          'overallElo', 'chessElo', 'arcadeElo', 'bestElo',
          'totalMatches', 'wins', 'losses', 'draws',
          'chessMatches', 'chessWins', 'arcadeMatches', 'arcadeWins',
          'winStreak', 'bestWinStreak', 'lastMatchId', 'lastGameTitle',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
        data.avatarId is string && data.avatarId.size() > 0 && data.avatarId.size() <= 64 &&
        data.isListed is bool &&
        data.overallElo is int && data.overallElo >= 100 && data.overallElo <= 4000 &&
        data.chessElo is int && data.chessElo >= 100 && data.chessElo <= 4000 &&
        data.arcadeElo is int && data.arcadeElo >= 100 && data.arcadeElo <= 4000 &&
        data.bestElo is int && data.bestElo >= 100 && data.bestElo <= 4000 &&
        data.totalMatches is int && data.totalMatches >= 0 && data.totalMatches <= 1000000 &&
        data.wins is int && data.wins >= 0 && data.wins <= data.totalMatches &&
        data.losses is int && data.losses >= 0 && data.losses <= data.totalMatches &&
        data.draws is int && data.draws >= 0 && data.draws <= data.totalMatches &&
        (data.wins + data.losses + data.draws) == data.totalMatches &&
        data.chessMatches is int && data.chessMatches >= 0 && data.chessMatches <= data.totalMatches &&
        data.chessWins is int && data.chessWins >= 0 && data.chessWins <= data.chessMatches &&
        data.arcadeMatches is int && data.arcadeMatches >= 0 && data.arcadeMatches <= data.totalMatches &&
        data.arcadeWins is int && data.arcadeWins >= 0 && data.arcadeWins <= data.arcadeMatches &&
        data.winStreak is int && data.winStreak >= 0 && data.winStreak <= data.totalMatches &&
        data.bestWinStreak is int && data.bestWinStreak >= data.winStreak && data.bestWinStreak <= data.totalMatches &&
        (data.lastMatchId == null || isValidId(data.lastMatchId)) &&
        (data.lastGameTitle == null || (data.lastGameTitle is string && data.lastGameTitle.size() > 0 && data.lastGameTitle.size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMatchRecord(data) {
      return data.keys().hasAll([
          'id', 'sourceType', 'roomCode', 'gameKind', 'gameType', 'gameTitle',
          'p1Uid', 'p1Name', 'p1AvatarId', 'p2Uid', 'p2Name', 'p2AvatarId',
          'winnerSeat', 'p1Delta', 'p2Delta', 'p1EloAfter', 'p2EloAfter',
          'p1CatDelta', 'p2CatDelta', 'p1CatEloAfter', 'p2CatEloAfter',
          'isPublic', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'sourceType', 'roomCode', 'gameKind', 'gameType', 'gameTitle',
          'p1Uid', 'p1Name', 'p1AvatarId', 'p2Uid', 'p2Name', 'p2AvatarId',
          'winnerSeat', 'p1Delta', 'p2Delta', 'p1EloAfter', 'p2EloAfter',
          'p1CatDelta', 'p2CatDelta', 'p1CatEloAfter', 'p2CatEloAfter',
          'isPublic', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.sourceType is string && data.sourceType.size() > 0 && data.sourceType.size() <= 16 &&
        data.sourceType in ['chessRoom', 'arcadeRoom'] &&
        isValidRoomCode(data.roomCode) &&
        data.gameKind is string && data.gameKind.size() > 0 && data.gameKind.size() <= 16 &&
        data.gameKind in ['chess', 'arcade'] &&
        data.gameType is string && data.gameType.size() > 0 && data.gameType.size() <= 32 &&
        data.gameTitle is string && data.gameTitle.size() > 0 && data.gameTitle.size() <= 64 &&
        isValidId(data.p1Uid) &&
        data.p1Name is string && data.p1Name.size() > 0 && data.p1Name.size() <= 64 &&
        data.p1AvatarId is string && data.p1AvatarId.size() > 0 && data.p1AvatarId.size() <= 64 &&
        isValidId(data.p2Uid) &&
        data.p1Uid != data.p2Uid &&
        data.p2Name is string && data.p2Name.size() > 0 && data.p2Name.size() <= 64 &&
        data.p2AvatarId is string && data.p2AvatarId.size() > 0 && data.p2AvatarId.size() <= 64 &&
        data.winnerSeat is string && data.winnerSeat.size() >= 2 && data.winnerSeat.size() <= 8 &&
        data.winnerSeat in ['p1', 'p2', 'draw'] &&
        data.p1Delta is int && data.p1Delta >= -64 && data.p1Delta <= 64 &&
        data.p2Delta is int && data.p2Delta >= -64 && data.p2Delta <= 64 &&
        data.p1EloAfter is int && data.p1EloAfter >= 100 && data.p1EloAfter <= 4000 &&
        data.p2EloAfter is int && data.p2EloAfter >= 100 && data.p2EloAfter <= 4000 &&
        data.p1CatDelta is int && data.p1CatDelta >= -64 && data.p1CatDelta <= 64 &&
        data.p2CatDelta is int && data.p2CatDelta >= -64 && data.p2CatDelta <= 64 &&
        data.p1CatEloAfter is int && data.p1CatEloAfter >= 100 && data.p1CatEloAfter <= 4000 &&
        data.p2CatEloAfter is int && data.p2CatEloAfter >= 100 && data.p2CatEloAfter <= 4000 &&
        data.isPublic is bool &&
        data.createdAt is timestamp;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Cloud Game Saves Subcollection
      match /saves/{saveId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(saveId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(saveId) && isValidGameSave(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(saveId);
      }

      // Game Statistics Subcollection
      match /stats/{gameId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(gameId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(gameId) && isValidGameStats(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(gameId);
      }

      // Added Friends / Chat Contacts Subcollection
      match /contacts/{contactUid} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(contactUid);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
          request.auth.uid == userId &&
          isValidId(contactUid) &&
          contactUid != request.auth.uid &&
          isValidUserContact(incoming()) &&
          incoming().contactUid == contactUid &&
          incoming().addedAt == request.time &&
          exists(/databases/$(database)/documents/chatProfiles/$(contactUid));
        allow update: if isSignedIn() &&
          request.auth.uid == userId &&
          isValidId(contactUid) &&
          isValidUserContact(incoming()) &&
          incoming().contactUid == existing().contactUid &&
          incoming().addedAt == existing().addedAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'friendCode', 'avatarId', 'nickname']);
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(contactUid);
      }
    }

    // Public Non-PII Chat Directory Profiles (Discoverable Firebase Players)
    match /chatProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        userId == request.auth.uid ||
        (resource != null && existing().discoverable == true)
      );
      allow list: if isSignedIn() && resource.data.discoverable == true;
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidChatProfile(incoming()) &&
        incoming().lastSeenAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidChatProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'friendCode', 'avatarId', 'discoverable', 'isOnline', 'lastSeenAt', 'updatedAt'
        ]) &&
        incoming().lastSeenAt == request.time &&
        incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Direct Message Chat Threads
    match /chatThreads/{threadId} {
      allow get: if isSignedIn() && isValidId(threadId) && (
        (resource == null && (
          threadId.matches('^' + request.auth.uid + '_[a-zA-Z0-9_\\-]+$') ||
          threadId.matches('^[a-zA-Z0-9_\\-]+_' + request.auth.uid + '$')
        )) ||
        (resource != null && (
          existing().userAUid == request.auth.uid ||
          existing().userBUid == request.auth.uid
        ))
      );
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn() &&
        isValidId(threadId) &&
        isValidChatThread(incoming()) &&
        incoming().threadId == threadId &&
        (incoming().userAUid == request.auth.uid || incoming().userBUid == request.auth.uid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/chatProfiles/$(incoming().userAUid)) &&
        exists(/databases/$(database)/documents/chatProfiles/$(incoming().userBUid));
      allow update: if isSignedIn() &&
        isValidId(threadId) &&
        isValidChatThread(incoming()) &&
        (existing().userAUid == request.auth.uid || existing().userBUid == request.auth.uid) &&
        incoming().threadId == existing().threadId &&
        incoming().userAUid == existing().userAUid &&
        incoming().userBUid == existing().userBUid &&
        incoming().participantUids == existing().participantUids &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'lastMessageText', 'lastMessageSenderUid', 'userAName', 'userBName', 'userAAvatarId', 'userBAvatarId', 'updatedAt'
        ]) &&
        (
          incoming().lastMessageSenderUid == null ||
          incoming().lastMessageSenderUid == request.auth.uid ||
          incoming().lastMessageSenderUid == existing().lastMessageSenderUid
        );
      allow delete: if false;

      // Direct Messages Subcollection (Atomically tied to parent chatThread via getAfter/existsAfter)
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(threadId) && isValidId(messageId) && (
          (resource == null && (
            threadId.matches('^' + request.auth.uid + '_[a-zA-Z0-9_\\-]+$') ||
            threadId.matches('^[a-zA-Z0-9_\\-]+_' + request.auth.uid + '$')
          )) ||
          (resource != null && request.auth.uid in existing().participantUids)
        );
        allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;
        allow create: if isSignedIn() &&
          isValidId(threadId) &&
          isValidId(messageId) &&
          isValidChatMessage(incoming()) &&
          incoming().id == messageId &&
          incoming().threadId == threadId &&
          incoming().createdAt == request.time &&
          existsAfter(/databases/$(database)/documents/chatThreads/$(threadId)) &&
          (
            getAfter(/databases/$(database)/documents/chatThreads/$(threadId)).data.userAUid == request.auth.uid ||
            getAfter(/databases/$(database)/documents/chatThreads/$(threadId)).data.userBUid == request.auth.uid
          ) &&
          incoming().participantUids == getAfter(/databases/$(database)/documents/chatThreads/$(threadId)).data.participantUids;
        allow update, delete: if false;
      }
    }

    // Online Chess Rooms (1v1 & 2v2, addressed strictly by room code; no list queries permitted)
    match /chessRooms/{roomCode} {
      allow get: if isSignedIn() && isValidRoomCode(roomCode);

      allow create: if isSignedIn() &&
        isValidRoomCode(roomCode) &&
        isValidChessRoom(incoming()) &&
        incoming().code == roomCode &&
        incoming().creatorAuthUid == request.auth.uid &&
        incoming().status in ['waiting', 'active'] &&
        incoming().moves.size() == 0 &&
        incoming().turn == 'w' &&
        incoming().whiteTimeMs == incoming().baseMs &&
        incoming().blackTimeMs == incoming().baseMs &&
        incoming().clockAnchorMs == null &&
        incoming().resignedWinner == null &&
        incoming().timeoutWinner == null &&
        incoming().rematchVotes.size() == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          incoming().whiteAuthUid == request.auth.uid ||
          incoming().blackAuthUid == request.auth.uid ||
          ('participantUids' in incoming() && request.auth.uid in incoming().participantUids)
        );

      allow update: if isSignedIn() &&
        isValidRoomCode(roomCode) &&
        isValidChessRoom(incoming()) &&
        incoming().code == existing().code &&
        incoming().creatorAuthUid == existing().creatorAuthUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().timeControlId == existing().timeControlId &&
        incoming().baseMs == existing().baseMs &&
        incoming().incMs == existing().incMs &&
        incoming().updatedAt == request.time &&
        (!('teamMode' in existing()) || incoming().teamMode == existing().teamMode) &&
        (
          // Action: Join, Reconnect, Switch Team, Vacate Seat, Fill Bots, or Clear Bots
          (
            existing().status != 'finished' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'teamMode', 'whiteSeats', 'blackSeats', 'participantUids', 'activeSeatKind', 'activeSeatUid',
              'whiteAuthUid', 'whitePlayerId', 'whiteName',
              'blackAuthUid', 'blackPlayerId', 'blackName',
              'status', 'updatedAt'
            ]) &&
            (
              isChessRoomParticipant(existing()) ||
              (
                (existing().status == 'waiting' || existing().moves.size() == 0) &&
                (
                  incoming().whiteAuthUid == request.auth.uid ||
                  incoming().blackAuthUid == request.auth.uid ||
                  ('participantUids' in incoming() && request.auth.uid in incoming().participantUids)
                ) &&
                (!('participantUids' in existing()) || incoming().participantUids.size() >= existing().participantUids.size())
              )
            )
          ) ||
          // Action: Active Turn Seat (Human or Bot Runner) Makes Exactly One Move
          (
            existing().status != 'finished' &&
            (
              ('activeSeatUid' in existing() && existing().activeSeatKind == 'human' && existing().activeSeatUid == request.auth.uid) ||
              ('activeSeatKind' in existing() && existing().activeSeatKind == 'bot' && isChessRoomParticipant(existing())) ||
              (!('activeSeatKind' in existing()) && (
                (existing().turn == 'w' && existing().whiteAuthUid == request.auth.uid) ||
                (existing().turn == 'b' && existing().blackAuthUid == request.auth.uid)
              ))
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'moves', 'turn', 'status', 'whiteTimeMs', 'blackTimeMs', 'clockAnchorMs',
              'rematchVotes', 'activeSeatKind', 'activeSeatUid', 'updatedAt'
            ]) &&
            incoming().moves.size() == existing().moves.size() + 1 &&
            incoming().moves[existing().moves.size()] is string &&
            incoming().moves[existing().moves.size()].size() >= 7 &&
            incoming().moves[existing().moves.size()].size() <= 16 &&
            incoming().turn != existing().turn
          ) ||
          // Action: Participant Resigns or Claims Clock Timeout
          (
            existing().status != 'finished' &&
            isChessRoomParticipant(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'resignedWinner', 'timeoutWinner', 'clockAnchorMs', 'whiteTimeMs', 'blackTimeMs', 'updatedAt'
            ]) &&
            incoming().status == 'finished' &&
            incoming().clockAnchorMs == null &&
            (incoming().resignedWinner != null || incoming().timeoutWinner != null)
          ) ||
          // Action: Seated Participant Votes for Rematch (Terminal State Only)
          (
            existing().status == 'finished' &&
            isChessRoomParticipant(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['rematchVotes', 'updatedAt']) &&
            incoming().rematchVotes.size() == existing().rematchVotes.size() + 1
          ) ||
          // Action: Seated Participant Executes Rematch Reset (Terminal State Only)
          (
            existing().status == 'finished' &&
            isChessRoomParticipant(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'teamMode', 'whiteSeats', 'blackSeats', 'participantUids', 'activeSeatKind', 'activeSeatUid',
              'whiteAuthUid', 'whitePlayerId', 'whiteName',
              'blackAuthUid', 'blackPlayerId', 'blackName',
              'moves', 'turn', 'status', 'whiteTimeMs', 'blackTimeMs',
              'clockAnchorMs', 'resignedWinner', 'timeoutWinner', 'rematchVotes', 'updatedAt'
            ]) &&
            incoming().moves.size() == 0 &&
            incoming().turn == 'w' &&
            incoming().status in ['waiting', 'active'] &&
            incoming().resignedWinner == null &&
            incoming().timeoutWinner == null &&
            incoming().rematchVotes.size() == 0 &&
            incoming().whiteTimeMs == existing().baseMs &&
            incoming().blackTimeMs == existing().baseMs &&
            incoming().clockAnchorMs == null
          )
        );

      allow delete: if isSignedIn() &&
        isValidRoomCode(roomCode) &&
        existing().creatorAuthUid == request.auth.uid &&
        existing().moves.size() == 0;
    }

    // Online Multiplayer Arcade Rooms (1v1 & 2v2 across 72 games; addressed strictly by room code)
    match /arcadeRooms/{roomCode} {
      allow get: if isSignedIn() && isValidRoomCode(roomCode);

      allow create: if isSignedIn() &&
        isValidRoomCode(roomCode) &&
        isValidArcadeRoom(incoming()) &&
        incoming().code == roomCode &&
        incoming().creatorAuthUid == request.auth.uid &&
        incoming().status in ['waiting', 'active'] &&
        incoming().moves.size() == 0 &&
        incoming().turn == 'p1' &&
        incoming().winner == null &&
        incoming().resignedWinner == null &&
        incoming().rematchVotes.size() == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          incoming().p1AuthUid == request.auth.uid ||
          incoming().p2AuthUid == request.auth.uid ||
          ('participantUids' in incoming() && request.auth.uid in incoming().participantUids)
        );

      allow update: if isSignedIn() &&
        isValidRoomCode(roomCode) &&
        isValidArcadeRoom(incoming()) &&
        incoming().code == existing().code &&
        incoming().gameType == existing().gameType &&
        incoming().creatorAuthUid == existing().creatorAuthUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (!('teamMode' in existing()) || incoming().teamMode == existing().teamMode) &&
        (
          // Action: Join, Reconnect, Switch Team, Vacate Seat, Fill Bots, or Clear Bots
          (
            existing().status != 'finished' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'teamMode', 'team1Seats', 'team2Seats', 'participantUids',
              'team1TurnCount', 'team2TurnCount', 'activeSeatKind', 'activeSeatUid',
              'p1AuthUid', 'p1PlayerId', 'p1Name',
              'p2AuthUid', 'p2PlayerId', 'p2Name',
              'status', 'updatedAt'
            ]) &&
            (
              isArcadeRoomParticipant(existing()) ||
              (
                (existing().status == 'waiting' || existing().moves.size() == 0) &&
                (
                  incoming().p1AuthUid == request.auth.uid ||
                  incoming().p2AuthUid == request.auth.uid ||
                  ('participantUids' in incoming() && request.auth.uid in incoming().participantUids)
                ) &&
                (!('participantUids' in existing()) || incoming().participantUids.size() >= existing().participantUids.size())
              )
            )
          ) ||
          // Action: Active Turn Seat (Human or Bot Runner) Makes Exactly One Move
          (
            existing().status != 'finished' &&
            (
              ('activeSeatUid' in existing() && existing().activeSeatKind == 'human' && existing().activeSeatUid == request.auth.uid) ||
              ('activeSeatKind' in existing() && existing().activeSeatKind == 'bot' && isArcadeRoomParticipant(existing())) ||
              (!('activeSeatKind' in existing()) && (
                (existing().turn == 'p1' && existing().p1AuthUid == request.auth.uid) ||
                (existing().turn == 'p2' && existing().p2AuthUid == request.auth.uid)
              ))
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'moves', 'turn', 'status', 'winner', 'rematchVotes',
              'team1TurnCount', 'team2TurnCount', 'activeSeatKind', 'activeSeatUid', 'updatedAt'
            ]) &&
            incoming().moves.size() == existing().moves.size() + 1 &&
            incoming().moves[existing().moves.size()] is string &&
            incoming().moves[existing().moves.size()].size() >= 1 &&
            incoming().moves[existing().moves.size()].size() <= 800
          ) ||
          // Action: Participant Resigns
          (
            existing().status != 'finished' &&
            isArcadeRoomParticipant(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'resignedWinner', 'updatedAt'
            ]) &&
            incoming().status == 'finished' &&
            incoming().resignedWinner != null
          ) ||
          // Action: Seated Participant Votes for Rematch (Terminal State Only)
          (
            existing().status == 'finished' &&
            isArcadeRoomParticipant(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['rematchVotes', 'updatedAt']) &&
            incoming().rematchVotes.size() == existing().rematchVotes.size() + 1
          ) ||
          // Action: Seated Participant Executes Rematch Reset (Terminal State Only)
          (
            existing().status == 'finished' &&
            isArcadeRoomParticipant(existing()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'teamMode', 'team1Seats', 'team2Seats', 'participantUids',
              'team1TurnCount', 'team2TurnCount', 'activeSeatKind', 'activeSeatUid',
              'p1AuthUid', 'p1PlayerId', 'p1Name',
              'p2AuthUid', 'p2PlayerId', 'p2Name',
              'moves', 'turn', 'status', 'winner', 'resignedWinner', 'rematchVotes', 'updatedAt'
            ]) &&
            incoming().moves.size() == 0 &&
            incoming().turn == 'p1' &&
            incoming().status in ['waiting', 'active'] &&
            incoming().winner == null &&
            incoming().resignedWinner == null &&
            incoming().rematchVotes.size() == 0
          )
        );

      allow delete: if isSignedIn() &&
        isValidRoomCode(roomCode) &&
        existing().creatorAuthUid == request.auth.uid &&
        existing().moves.size() == 0;
    }

    // Multiplayer Party Lobbies (1v1 & 2v2, up to 4 players, addressed by party code or memberUids list)
    match /parties/{partyCode} {
      allow get: if isSignedIn() && isValidRoomCode(partyCode);
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
        isValidRoomCode(partyCode) &&
        isValidParty(incoming()) &&
        incoming().id == partyCode &&
        incoming().leaderUid == request.auth.uid &&
        incoming().status == 'lobby' &&
        incoming().members.size() == 1 &&
        incoming().members[0].uid == request.auth.uid &&
        incoming().activeRoomCode == null &&
        incoming().activeLaunchId == null &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidRoomCode(partyCode) &&
        isValidParty(incoming()) &&
        incoming().id == existing().id &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action: New Member Joins Party (or Reconnects) up to 4 players
          (
            incoming().leaderUid == existing().leaderUid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['members', 'memberUids', 'updatedAt']) &&
            request.auth.uid in incoming().memberUids &&
            incoming().members.size() >= existing().members.size()
          ) ||
          // Action: Existing Member Switches Team or Leaves Party
          (
            request.auth.uid in existing().memberUids &&
            incoming().diff(existing()).affectedKeys().hasOnly(['leaderUid', 'members', 'memberUids', 'updatedAt'])
          ) ||
          // Action: Leader Updates Settings, Kicks Member, Launches Match, or Returns to Lobby
          (
            existing().leaderUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'leaderUid', 'status', 'matchMode', 'opponentMode',
              'gameKind', 'gameType', 'gameTitle', 'botId',
              'members', 'memberUids',
              'activeRoomCode', 'activeGameKind', 'activeGameType', 'activeLaunchId', 'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() &&
        isValidRoomCode(partyCode) &&
        (
          existing().leaderUid == request.auth.uid ||
          (request.auth.uid in existing().memberUids && existing().members.size() <= 1)
        );
    }

    // Party Invitations (strictly isolated to sender and recipient)
    match /partyInvites/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        resource == null || request.auth.uid in existing().participantUids
      );

      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;

      allow create: if isSignedIn() &&
        isValidId(inviteId) &&
        isValidPartyInvite(incoming()) &&
        incoming().id == inviteId &&
        incoming().fromUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/parties/$(incoming().partyId)) &&
        request.auth.uid in get(/databases/$(database)/documents/parties/$(incoming().partyId)).data.memberUids &&
        exists(/databases/$(database)/documents/chatProfiles/$(incoming().toUid));

      allow update: if isSignedIn() &&
        isValidId(inviteId) &&
        isValidPartyInvite(incoming()) &&
        incoming().id == existing().id &&
        incoming().partyId == existing().partyId &&
        incoming().partyCode == existing().partyCode &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().participantUids == existing().participantUids &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        existing().status == 'pending' &&
        (
          (request.auth.uid == existing().toUid && incoming().status in ['accepted', 'declined']) ||
          (request.auth.uid == existing().fromUid && incoming().status == 'cancelled')
        );

      allow delete: if isSignedIn() &&
        isValidId(inviteId) &&
        request.auth.uid in existing().participantUids;
    }

    // Direct Friend Game Invites (participant-isolated)
    match /gameInvites/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        resource == null || request.auth.uid in existing().participantUids
      );

      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;

      allow create: if isSignedIn() &&
        isValidId(inviteId) &&
        isValidGameInvite(incoming()) &&
        incoming().id == inviteId &&
        incoming().fromUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/chatProfiles/$(incoming().toUid));

      allow update: if isSignedIn() &&
        isValidId(inviteId) &&
        isValidGameInvite(incoming()) &&
        incoming().id == existing().id &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().participantUids == existing().participantUids &&
        incoming().gameKind == existing().gameKind &&
        incoming().gameType == existing().gameType &&
        incoming().gameTitle == existing().gameTitle &&
        incoming().roomCode == existing().roomCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        existing().status == 'pending' &&
        (
          (request.auth.uid == existing().toUid && incoming().status in ['accepted', 'declined']) ||
          (request.auth.uid == existing().fromUid && incoming().status == 'cancelled')
        );

      allow delete: if isSignedIn() &&
        isValidId(inviteId) &&
        request.auth.uid in existing().participantUids;
    }

    // Peer-to-Peer Voice/Video Call Signaling Sessions (strictly participant-isolated)
    match /callSessions/{callId} {
      allow get: if isSignedIn() && isValidId(callId) && (
        resource == null || request.auth.uid in existing().participantUids
      );

      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;

      allow create: if isSignedIn() &&
        isValidId(callId) &&
        isValidCallSession(incoming()) &&
        incoming().id == callId &&
        incoming().callerUid == request.auth.uid &&
        incoming().status == 'ringing' &&
        incoming().sdpAnswer == null &&
        incoming().endedAt == null &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          exists(/databases/$(database)/documents/users/$(incoming().calleeUid)) ||
          exists(/databases/$(database)/documents/chatProfiles/$(incoming().calleeUid))
        );

      allow update: if isSignedIn() &&
        isValidId(callId) &&
        isValidCallSession(incoming()) &&
        incoming().id == existing().id &&
        incoming().callerUid == existing().callerUid &&
        incoming().callerName == existing().callerName &&
        incoming().callerAvatarId == existing().callerAvatarId &&
        incoming().calleeUid == existing().calleeUid &&
        incoming().calleeName == existing().calleeName &&
        incoming().calleeAvatarId == existing().calleeAvatarId &&
        incoming().participantUids == existing().participantUids &&
        incoming().mode == existing().mode &&
        incoming().contextLabel == existing().contextLabel &&
        incoming().sdpOffer == existing().sdpOffer &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        !(existing().status in ['ended', 'declined', 'missed']) &&
        (
          // Callee answers ringing call
          (
            existing().status == 'ringing' &&
            request.auth.uid == existing().calleeUid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'sdpAnswer', 'updatedAt']) &&
            incoming().status == 'active' &&
            incoming().sdpAnswer != null
          ) ||
          // Callee declines ringing call
          (
            existing().status == 'ringing' &&
            request.auth.uid == existing().calleeUid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endedAt', 'updatedAt']) &&
            incoming().status == 'declined' &&
            incoming().endedAt == request.time
          ) ||
          // Caller cancels or marks ringing call missed
          (
            existing().status == 'ringing' &&
            request.auth.uid == existing().callerUid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endedAt', 'updatedAt']) &&
            incoming().status in ['ended', 'missed'] &&
            incoming().endedAt == request.time
          ) ||
          // Either participant hangs up an active call
          (
            existing().status == 'active' &&
            request.auth.uid in existing().participantUids &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endedAt', 'updatedAt']) &&
            incoming().status == 'ended' &&
            incoming().endedAt == request.time
          )
        );

      allow delete: if false;

      // Trickle ICE candidates subcollection
      match /candidates/{candidateId} {
        allow get: if isSignedIn() && isValidId(callId) && isValidId(candidateId) && (
          resource == null ||
          request.auth.uid == existing().fromUid ||
          request.auth.uid == existing().toUid
        );

        allow list: if isSignedIn() && resource.data.toUid == request.auth.uid;

        allow create: if isSignedIn() &&
          isValidId(callId) &&
          isValidId(candidateId) &&
          isValidCallCandidate(incoming()) &&
          incoming().id == candidateId &&
          incoming().fromUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/callSessions/$(callId)) &&
          request.auth.uid in get(/databases/$(database)/documents/callSessions/$(callId)).data.participantUids &&
          incoming().toUid in get(/databases/$(database)/documents/callSessions/$(callId)).data.participantUids;

        allow update, delete: if false;
      }
    }

    // Public Non-PII Player ELO Leaderboard Profiles
    match /leaderboardProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.isListed == true;

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidLeaderboardProfile(incoming()) &&
        incoming().userId == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            incoming().totalMatches == 0 &&
            incoming().wins == 0 &&
            incoming().losses == 0 &&
            incoming().draws == 0 &&
            incoming().chessMatches == 0 &&
            incoming().chessWins == 0 &&
            incoming().arcadeMatches == 0 &&
            incoming().arcadeWins == 0 &&
            incoming().winStreak == 0 &&
            incoming().bestWinStreak == 0 &&
            incoming().overallElo == 1200 &&
            incoming().chessElo == 1200 &&
            incoming().arcadeElo == 1200 &&
            incoming().bestElo == 1200 &&
            incoming().lastMatchId == null
          ) ||
          (
            incoming().totalMatches == 1 &&
            (incoming().wins + incoming().losses + incoming().draws) == 1 &&
            (incoming().chessMatches + incoming().arcadeMatches) == 1 &&
            incoming().overallElo >= 1136 && incoming().overallElo <= 1264 &&
            incoming().chessElo >= 1136 && incoming().chessElo <= 1264 &&
            incoming().arcadeElo >= 1136 && incoming().arcadeElo <= 1264 &&
            incoming().lastMatchId != null &&
            existsAfter(/databases/$(database)/documents/matchRecords/$(incoming().lastMatchId))
          )
        );

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidLeaderboardProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarId', 'updatedAt']) ||
          (
            incoming().totalMatches == existing().totalMatches + 1 &&
            (incoming().wins + incoming().losses + incoming().draws) == (existing().wins + existing().losses + existing().draws + 1) &&
            (incoming().chessMatches + incoming().arcadeMatches) == (existing().chessMatches + existing().arcadeMatches + 1) &&
            incoming().overallElo >= existing().overallElo - 64 &&
            incoming().overallElo <= existing().overallElo + 64 &&
            incoming().chessElo >= existing().chessElo - 64 &&
            incoming().chessElo <= existing().chessElo + 64 &&
            incoming().arcadeElo >= existing().arcadeElo - 64 &&
            incoming().arcadeElo <= existing().arcadeElo + 64 &&
            incoming().lastMatchId != null &&
            incoming().lastMatchId != existing().lastMatchId &&
            existsAfter(/databases/$(database)/documents/matchRecords/$(incoming().lastMatchId))
          )
        );

      allow delete: if false;
    }

    // Immutable Completed PvP Match Records (verifiable against finished Chess or Arcade rooms)
    match /matchRecords/{matchId} {
      allow get: if isSignedIn() && isValidId(matchId);
      allow list: if isSignedIn() && resource.data.isPublic == true;

      allow create: if isSignedIn() &&
        isValidId(matchId) &&
        isValidMatchRecord(incoming()) &&
        incoming().id == matchId &&
        (request.auth.uid == incoming().p1Uid || request.auth.uid == incoming().p2Uid) &&
        incoming().createdAt == request.time &&
        (
          (
            incoming().sourceType == 'chessRoom' &&
            incoming().gameKind == 'chess' &&
            exists(/databases/$(database)/documents/chessRooms/$(incoming().roomCode)) &&
            get(/databases/$(database)/documents/chessRooms/$(incoming().roomCode)).data.status == 'finished' &&
            get(/databases/$(database)/documents/chessRooms/$(incoming().roomCode)).data.whiteAuthUid == incoming().p1Uid &&
            get(/databases/$(database)/documents/chessRooms/$(incoming().roomCode)).data.blackAuthUid == incoming().p2Uid
          ) ||
          (
            incoming().sourceType == 'arcadeRoom' &&
            incoming().gameKind == 'arcade' &&
            exists(/databases/$(database)/documents/arcadeRooms/$(incoming().roomCode)) &&
            get(/databases/$(database)/documents/arcadeRooms/$(incoming().roomCode)).data.status == 'finished' &&
            get(/databases/$(database)/documents/arcadeRooms/$(incoming().roomCode)).data.p1AuthUid == incoming().p1Uid &&
            get(/databases/$(database)/documents/arcadeRooms/$(incoming().roomCode)).data.p2AuthUid == incoming().p2Uid
          )
        );

      allow update, delete: if false;
    }
  }
}
